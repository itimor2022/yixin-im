# 复制本文件为 keystore.properties 并填写真实值
# keystore.properties 已在 .gitignore 中排除，不会提交到版本控制
#
# 生成 keystore 命令：
#   keytool -genkey -v -keystore release.jks -alias yixin -keyalg RSA -keysize 2048 -validity 10000
#
# 将生成的 release.jks 放到 android/ 目录下，然后填写以下配置：

storeFile=../release.jks
storePassword=123456
keyAlias=yixin
keyPassword=123456
