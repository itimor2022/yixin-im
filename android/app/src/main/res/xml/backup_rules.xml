<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ 备份规则配置
   用于控制应用数据的自动备份行为
-->
<full-backup-content>
    <!-- 排除敏感数据，不进行备份 -->
    <exclude domain="sharedpref" path="flutter_secure_storage.xml"/>
    <exclude domain="sharedpref" path="flutter_secure_storage_keychain.xml"/>
    
    <!-- 排除临时文件 -->
    <exclude domain="external" path="Android/data/com.yixinim.app.v2/cache"/>
</full-backup-content>
