<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
    网络安全配置
    - `cleartextTrafficPermitted="true"`：允许 HTTP 明文流量。
      场景：api.txt 里配置了 `http://1.2.3.4:8081` 之类的裸 IP 接口，或者
      自建服务器还没申请 TLS 证书。若不打开，Android 9+ 会直接把 http 请求
      拦成 CLEARTEXT_NOT_PERMITTED，测速页永远显示"不可用"。
    - 想强制走 HTTPS 恢复严格模式：把 base-config 里的 true 改回 false 即可，
      TLS 证书校验行为不受影响。
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
