<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 
    网络安全配置
    - 开发环境: 允许 HTTP 明文流量 (localhost, 192.168.31.242, 局域网)
    - 生产环境: 只需要删除 cleartextTrafficPermitted="true" 或整个 debug-overrides
    -->
    
    <!-- 默认配置: 生产环境使用 HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    
